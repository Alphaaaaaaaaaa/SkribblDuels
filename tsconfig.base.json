{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "paths": {
      "@skribbl-duels/telemetry-contracts": [
        "./packages/telemetry-contracts/src/index.ts"
      ],
      "@skribbl-duels/telemetry-core": [
        "./packages/telemetry-core/src/index.ts"
      ],
      "@skribbl-duels/telemetry-replay": [
        "./packages/telemetry-replay/src/index.ts"
      ],
      "@skribbl-duels/challenge-engine": [
        "./packages/challenge-engine/src/index.ts"
      ],
      "@skribbl-duels/challenge-definitions": [
        "./packages/challenge-definitions/src/index.ts"
      ],
      "@skribbl-duels/product-core": [
        "./packages/product-core/src/index.ts"
      ],
      "@skribbl-duels/gateway-contracts": [
        "./packages/gateway-contracts/src/index.ts"
      ],
      "@skribbl-duels/gateway-client": [
        "./packages/gateway-client/src/index.ts"
      ],
      "@skribbl-duels/auth-client": [
        "./packages/auth-client/src/index.ts"
      ]
    }
  }
}
